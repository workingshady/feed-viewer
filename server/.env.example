# SQLite (default dev): busy_timeout reduces SQLITE_BUSY under concurrent reads/writes (ms)
DATABASE_URL="file:./prisma/dev.db?busy_timeout=5000"

# Postgres example (for server-side listings mode):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/feed_viewer_pro?schema=public"
PORT=8788
SESSION_COOKIE_NAME="sid"
SESSION_TTL_DAYS=30
# Optional tracing (see server/src/logger.ts)
# LOG_HTTP=0
# LOG_VERBOSE=1
