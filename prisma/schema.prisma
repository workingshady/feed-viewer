generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  admin
  editor
  viewer
}

enum VersionStatus {
  ready
  failed
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  role         Role          @default(viewer)
  createdAt    DateTime      @default(now())
  sessions     Session[]
  prefs        UserPref[]
  versions       FeedVersion[]
  auditEvents    AuditEvent[]
  matchDecisions MatchDecision[]
  matchModels    MatchModel[]
}

model Session {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model Source {
  id              String        @id @default(cuid())
  name            String        @unique
  agencyName      String
  agencyInfo      Json?
  /// MappingConfig used to parse this source's feeds; null = auto-detect.
  mapping         Json?
  activeVersionId String?       @unique
  activeVersion   FeedVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  retainVersions  Int           @default(5)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  versions        FeedVersion[] @relation("SourceVersions")
  shares          ShareLink[]
}

model FeedVersion {
  id                 String        @id @default(cuid())
  sourceId           String
  source             Source        @relation("SourceVersions", fields: [sourceId], references: [id], onDelete: Cascade)
  activeFor          Source?       @relation("ActiveVersion")
  number             Int
  status             VersionStatus @default(ready)
  fileName           String
  fileBytes          Int
  sha256             String
  /// Fingerprint of the mapping used to parse; "" = auto-detect. Same file + same mapping = duplicate.
  mappingFingerprint String        @default("")
  uploadId           String
  xmlBlobUrl         String
  listingsBlobUrl    String
  listingCount       Int
  added              Int           @default(0)
  removed            Int           @default(0)
  changed            Int           @default(0)
  warnings           Json?
  /// Quality metrics computed at upload: { score, photos, permit, coords, description, price, duplicates… }
  stats              Json?
  note               String?
  pinned             Boolean       @default(false)
  createdById        String?
  createdBy          User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())

  @@unique([sourceId, number])
  @@unique([sourceId, sha256, mappingFingerprint])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model UserPref {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  value  Json

  @@id([userId, key])
}

enum InviteKind {
  invite
  reset
}

/// One-time link to create an account (invite) or set a new password (reset). Only a hash of the token is stored.
model Invite {
  id          String     @id @default(cuid())
  tokenHash   String     @unique
  kind        InviteKind
  role        Role       @default(viewer)
  /// For reset links: the account whose password is being reset.
  userId      String?
  note        String?
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime   @default(now())
}

enum ShareKind {
  listing
  source
}

/// Read-only public link to one listing or to a source's live listings. Only a hash of the token is stored.
model ShareLink {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  kind         ShareKind
  sourceId     String
  source       Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  listingRef   String?
  label        String
  createdById  String?
  expiresAt    DateTime?
  revokedAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([sourceId])
}

enum MatchVerdict {
  same
  different
}

/// A reviewer's verdict on a suggested "same property" pair or group. Applied before scoring, so it
/// takes effect for everyone immediately, and used as labelled data when the model is retrained.
model MatchDecision {
  id          String       @id @default(cuid())
  /// Sorted listing ids joined with "|": stable across re-runs while the same listings are grouped.
  pairKey     String       @unique
  listingIds  Json
  /** What the reviewer saw: agency, reference, title, price, photo per listing, kept after listings leave the feed. */
  snapshot    Json?
  verdict     MatchVerdict
  /// "versions" (re-post within one feed) or "agencies" (across agencies).
  context     String
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([updatedAt])
}

/// Learned property-matching weights. One row is active at a time; older rows are history for rollback.
model MatchModel {
  id          String    @id @default(cuid())
  weights     Json
  /// Precision / recall measured on held-out labelled pairs, training counts, gate result.
  metrics     Json
  active      Boolean   @default(false)
  /// "auto" (scheduled background retrain) or "manual" (Retrain now).
  trigger     String
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  activatedAt DateTime?

  @@index([active])
  @@index([createdAt])
}
